# Скопируй в .env для локального запуска. Сам .env в git не попадает.
BOT_TOKEN=вставь_токен_от_BotFather
ADMIN_IDS=1999072927
DB_PATH=data/bot.db

# --- Интеграция с ботом регистрации (bc2regbot). Без BC_API_URL выключена. ---
# Адрес бота регистрации в приватной сети Railway
BC_API_URL=
# = INTEGRATION_TOKEN бота регистрации
BC_API_TOKEN=
# = GAMIFICATION_WEBHOOK_SECRET бота регистрации
BC_WEBHOOK_SECRET=
# Username бота регистрации без @ (для подсказки «сначала активируй бота участника»)
BC_REG_BOT_USERNAME=businesscup2_regbot
# 1 → автоматически одобрять заявки в общий чат фотоханта активировавшим бота регистрации
BC_AUTO_APPROVE_JOIN=0
